import 'package:hive/hive.dart';

part 'todo_model.g.dart';

@HiveType(typeId: 0)
class TodoModel extends HiveObject {

  @HiveField(0)
  String title;

  @HiveField(1)
  bool isDone;

  @HiveField(2)
  String? firebaseId;

  @HiveField(3)
  DateTime createdAt;

  @HiveField(4)
  DateTime updatedAt;

  @HiveField(5)
  bool isDeleted;

  @HiveField(6)
  bool needsSync;

  TodoModel({
    required this.title,
    required this.isDone,
    required this.createdAt,
    required this.updatedAt,
    this.firebaseId,
    this.isDeleted = false,
    this.needsSync = true,
  });

  /// Convert Firestore → Model
  factory TodoModel.fromMap(Map<String, dynamic> map, String id) {
    return TodoModel(
      title: map['title'] ?? '',
      isDone: map['isDone'] ?? false,
      firebaseId: id,
      createdAt: map['createdAt'] != null
          ? map['createdAt'].toDate()
          : DateTime.now(),
      updatedAt: map['updatedAt'] != null
          ? map['updatedAt'].toDate()
          : DateTime.now(),
      isDeleted: map['isDeleted'] ?? false,
      needsSync: false,
    );
  }

  /// Convert Model → Firestore
  Map<String, dynamic> toMap() {
    return {
      'title': title,
      'isDone': isDone,
      'createdAt': createdAt,
      'updatedAt': updatedAt,
      'isDeleted': isDeleted,
    };
  }
}
